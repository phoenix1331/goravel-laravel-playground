{{ define "index.tmpl" }}
<!DOCTYPE html>
<html lang="en-GB">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ .Name }}</title>
    <style>
        :root { --bg: #f8fafc; --card: #ffffff; --text: #0f172a; --muted: #64748b; --accent: #0e7490; --border: #e2e8f0; }
        @media (prefers-color-scheme: dark) {
            :root { --bg: #0f172a; --card: #1e293b; --text: #f1f5f9; --muted: #94a3b8; --accent: #22d3ee; --border: #334155; }
        }
        body { margin: 0; background: var(--bg); color: var(--text); font-family: system-ui, sans-serif; line-height: 1.5; }
        main { max-width: 760px; margin: 0 auto; padding: 48px 16px; }
        .logo { display: block; width: 280px; max-width: 100%; margin: 0 auto 32px; }
        p { color: var(--muted); text-align: center; }
        table { width: 100%; border-collapse: collapse; margin-top: 32px; background: var(--card); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
        th, td { text-align: left; padding: 8px 16px; border-bottom: 1px solid var(--border); }
        th { color: var(--muted); font-weight: 600; font-size: 0.85rem; }
        code { font-family: ui-monospace, monospace; font-size: 0.9rem; }
        .method { color: var(--accent); font-weight: 600; white-space: nowrap; }
        a { color: var(--accent); }
    </style>
</head>
<body>
<main>
    <img class="logo" src="https://www.goravel.dev/logo.png" alt="Goravel">
    <p>{{ .Description }}</p>
    <p><a href="{{ .Docs }}">Goravel for Laravel devs on GitHub</a></p>

    <table>
        <thead><tr><th>Method</th><th>Path</th></tr></thead>
        <tbody>
        {{ range .Endpoints }}
            <tr>
                <td class="method">{{ .Method }}</td>
                <td>
                    {{ if eq .Method "GET" }}<a href="{{ .Path }}"><code>{{ .Path }}</code></a>
                    {{ else }}<code>{{ .Path }}</code>{{ end }}
                </td>
            </tr>
        {{ end }}
        </tbody>
    </table>
</main>
</body>
</html>
{{ end }}
