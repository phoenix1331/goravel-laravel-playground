@baseUrl = http://localhost:8000

# Writes need a token. Send the "Log in" request below, then paste its
# access_token here. Seeded admins: admin1@example.com to admin6@example.com,
# password "password" (admin1 runs club 1, and so on).
@token = paste-the-access-token-here

### Index

# Lists every endpoint (the app is API only)
GET {{baseUrl}}/
Accept: application/json

### Auth

# Log in: returns a JWT in access_token
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
Accept: application/json

{
  "email": "admin1@example.com",
  "password": "password"
}

###

# The user the token belongs to
GET {{baseUrl}}/api/auth/me
Accept: application/json
Authorization: Bearer {{token}}

###

# Log out: the token stops working
POST {{baseUrl}}/api/auth/logout
Accept: application/json
Authorization: Bearer {{token}}

### Health

# Reports whether the app can reach its database (200 when up, 503 when down)
GET {{baseUrl}}/health
Accept: application/json

### League

# Closure route inside the /api group
GET {{baseUrl}}/api/league
Accept: application/json

###

# Named handler function route
GET {{baseUrl}}/api/league/points
Accept: application/json

###

# Unknown URL: the fallback route returns a JSON 404
GET {{baseUrl}}/does-not-exist
Accept: application/json

### Clubs

# List clubs, ordered by name
GET {{baseUrl}}/api/clubs
Accept: application/json

###

# Create a club
POST {{baseUrl}}/api/clubs
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
  "name": "Hillside United",
  "ground": "Hillside Rec",
  "founded_year": 1987
}

###

# Show one club (404 JSON if it does not exist)
GET {{baseUrl}}/api/clubs/1
Accept: application/json

###

# Update a club
PUT {{baseUrl}}/api/clubs/1
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
  "name": "Hillside United FC",
  "ground": "Hillside Recreation Ground",
  "founded_year": 1987
}

###

# Delete a club
DELETE {{baseUrl}}/api/clubs/1
Accept: application/json
Authorization: Bearer {{token}}

###

# Validation failure: blank name, missing ground, founded_year too early (422)
POST {{baseUrl}}/api/clubs
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
  "name": "   ",
  "founded_year": 1800
}

### Middleware

# Not JSON: EnsureJson middleware rejects it with 415 before the controller runs
POST {{baseUrl}}/api/clubs
Content-Type: application/x-www-form-urlencoded
Accept: application/json

name=Form+FC&ground=Park

### Players

# A club with its squad, ordered by squad number
GET {{baseUrl}}/api/clubs/1/players
Accept: application/json

###

# Add a player to a club's squad
POST {{baseUrl}}/api/clubs/1/players
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
  "name": "Sam Keeper",
  "position": "goalkeeper",
  "squad_number": 1
}

### Fixtures

# Fixtures with home and away clubs eager loaded
GET {{baseUrl}}/api/fixtures
Accept: application/json

### League table

# League table built from finished fixtures with the query builder
GET {{baseUrl}}/api/league/table
Accept: application/json

###

# Goals per club from a raw SQL query
GET {{baseUrl}}/api/league/goals
Accept: application/json

###

# Record a final score: fires FixtureResultRecorded, which notifies both clubs' admins.
# Only the home club's admin may do this: adminN@example.com runs club N, so check
# home_club_id in GET /api/fixtures and log in as that admin first (403 otherwise)
POST {{baseUrl}}/api/fixtures/9/result
Content-Type: application/json
Accept: application/json
Authorization: Bearer {{token}}

{
  "home_score": 2,
  "away_score": 1
}

### Demo feed

# Stand-in for the league's results API, used by sync:fixtures with FIXTURE_FEED_DRIVER=http
GET {{baseUrl}}/api/demo/results
Accept: application/json
